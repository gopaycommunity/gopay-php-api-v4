# GoPay PHP SDK — E2E test environment
# Copy to .env.e2e (gitignored) and fill in your credentials.
#
# The Stoplight mock API accepts any credentials and never charges a card.
# Use it for local E2E runs without real sandbox access.
GOPAY_PAYMENTS_V4_BASE_URL=https://stoplight.io/mocks/gopay-api/merchant-v4/10757016

# Sandbox credentials from https://portal.gopay.cz
# Leave blank to skip all E2E tests.
GOPAY_PAYMENTS_V4_CLIENT_ID=
GOPAY_PAYMENTS_V4_CLIENT_SECRET=
GOPAY_PAYMENTS_V4_GOID=
GOPAY_PAYMENTS_V4_SHAREABLE_KEY=
