{
  "commit-msg": {
    "enabled": true,
    "actions": [
      {
        "action": "\\CaptainHook\\App\\Hook\\Message\\Action\\Regex",
        "options": {
          "regex": "/\\A(feat|fix|chore|docs|style|refactor|test|ci|build|perf|revert)(\\([^)]+\\))?(!)?:\\s[^\\n]+/"
        }
      },
      {
        "action": "\\CaptainHook\\App\\Hook\\Message\\Action\\Regex",
        "options": {
          "regex": "/GPOMA-[0-9]+/m"
        }
      }
    ]
  },
  "pre-commit": {
    "enabled": true,
    "actions": [
      {
        "action": "\\CaptainHook\\App\\Hook\\PHP\\Action\\Linting"
      }
    ]
  }
}
