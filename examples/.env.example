# GoPay PHP SDK — example environment
# Copy this file to examples/.env and fill in your credentials.
# .env is gitignored — never commit real credentials.
#
# Use the Stoplight mock server for safe local testing (no real charges):
GOPAY_PAYMENTS_V4_BASE_URL=https://stoplight.io/mocks/gopay-api/merchant-v4/10757016

# Sandbox credentials from https://portal.gopay.cz
GOPAY_PAYMENTS_V4_CLIENT_ID=
GOPAY_PAYMENTS_V4_CLIENT_SECRET=
GOPAY_PAYMENTS_V4_GOID=
GOPAY_PAYMENTS_V4_SHAREABLE_KEY=
