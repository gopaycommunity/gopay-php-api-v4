includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon

parameters:
    level: 9
    phpVersion: 80100
    paths:
        - src
        - tests
    excludePaths:
        - src/Generated
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # phpstan-strict-rules DynamicCallOnStaticMethodRule fires for PHPUnit's
        # $this->assertXxx() pattern, which is idiomatic in PHPUnit even though
        # Assert methods are technically static.
        -
            message: '#Dynamic call to static method PHPUnit\\Framework\\Assert::#'
            path: tests
